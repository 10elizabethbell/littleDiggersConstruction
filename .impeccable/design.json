      "css": ":host{--soil:#46311f;--ink:#2a1f16;--bone:#f2efe7;--bone-soft:#dcd1c1;--yellow:#f5c518;--yellow-hot:#ffd84a;--pink:#ff5c9e;--granite:#dad9d3;--ink-soft:#57473a;--fb:#1665d8;--font:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif} .ds-top{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 16px;background:var(--soil);color:var(--bone);font-family:var(--font)} .ds-brand{display:flex;flex-direction:column;line-height:1;text-decoration:none;color:inherit} .ds-brand b{font-weight:900;font-size:21px;letter-spacing:-.01em;text-transform:uppercase} .ds-brand span{font-size:12px;font-weight:700;letter-spacing:.24em;text-transform:uppercase;color:var(--bone-soft);margin-top:5px} .ds-tel{display:inline-flex;align-items:center;gap:8px;min-height:44px;font-weight:800;font-size:17px;text-decoration:none;color:inherit} .ds-tel svg{color:var(--yellow)} .ds-tel:hover{color:var(--yellow-hot)} .ds-tel:focus-visible,.ds-brand:focus-visible{outline:3px solid var(--pink);outline-offset:3px;border-radius:4px}"
